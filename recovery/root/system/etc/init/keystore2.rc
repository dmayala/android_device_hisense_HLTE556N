# Pinned recovery keystore2 definition, with the A9 absent-HAL lookup bound.
# Keep the upstream temporary database and recovery credentials unchanged.
on late-init
    start keystore2

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
    setenv LD_PRELOAD /system/lib64/liba9_recovery_crypto_wait.so
