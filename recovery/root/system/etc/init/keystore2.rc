# Pinned recovery keystore2 definition, with the A9 absent-HAL lookup bound.
# Started by crypto_ready after the recovery VINTF view is installed. The
# upstream VINTF helper dereferences a missing/invalid manifest without a check.

service keystore2 /system/bin/a9-crypto/launcher keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    disabled
    user root
    group keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
    namespace mnt
    setenv LD_PRELOAD /system/lib64/liba9_crypto_diagnostics.so:/system/lib64/liba9_recovery_crypto_wait.so
