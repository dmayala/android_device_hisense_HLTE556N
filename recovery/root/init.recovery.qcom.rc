on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1
    # Ramdisk capability marker; installers check this BEFORE requesting a reset.
    setprop ro.twrp.a9.los24_vendor 1
    setprop ro.twrp.a9.crypto self

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# Keymaster version for /data decryption.
#
# TWRP reads this (TW_KEYMASTER_VERSION_PROP = "keymaster_ver") when it cannot
# find the HAL version in the vendor manifest, which is what happened here:
#   Keymaster_Ver::Unable to find vendor manifest ... and no default value set
#   Keymaster_Ver::Using keymaster version '' for decryption
#
# 4.0 is measured from the device's own /vendor/etc/vintf/manifest.xml:
#   android.hardware.keymaster @4.0::IKeymasterDevice/default
on init
    setprop keymaster_ver 4.1

# Self-contained stock crypto, independent of the mounted slot's vendor DSOs.
# Keep these disabled until TWRP has copied its selected (or fallback) fstab.
# The gatekeeper passthrough implementation is also available in ramdisk
# /system/lib64/hw; the isolated linker namespace refuses slot-vendor modules.
# Keep executables under system/bin: mkbootfs fs_config assigns other paths
# 0644 regardless of their git executable bit. Libraries stay in a9-crypto/lib64.
service vendor.keymaster-4-1 /system/bin/a9-crypto/hw/android.hardware.keymaster@4.1-service-qti
    class early_hal
    disabled
    user root
    group root system drmrpc
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/a9-crypto/lib64:/system/lib64
    setenv LD_CONFIG_FILE /system/etc/a9-crypto.ld.config.txt
    setenv LD_PRELOAD /system/a9-crypto/lib64/liba9_crypto_paths.so

service gatekeeper-1-0 /system/bin/a9-crypto/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/a9-crypto/lib64:/system/lib64
    setenv LD_CONFIG_FILE /system/etc/a9-crypto.ld.config.txt
    setenv LD_PRELOAD /system/a9-crypto/lib64/liba9_crypto_paths.so

# qseecomd dlopens its listener libraries before it publishes
# vendor.sys.listeners.registered. Include those modules as well as DT_NEEDED.
service vendor.qseecomd /system/bin/a9-crypto/qseecomd
    class early_hal
    disabled
    user root
    group root
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/a9-crypto/lib64:/system/lib64
    setenv LD_CONFIG_FILE /system/etc/a9-crypto.ld.config.txt

on property:fstab.additional=1
    # Synchronous prep, then launch only when firmware and VINTF are ready.
    exec_start a9-crypto-vintf

on property:twrp.a9.crypto_ready=1
    start vendor.qseecomd
    start vendor.keymaster-4-1
    start gatekeeper-1-0

service a9-crypto-vintf /system/bin/sh /system/bin/a9-crypto-vintf.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

# init.recovery.service.rc was imported before this file. Preserve its socket
# and label; add only the recovery-local absent-service timeout shim.
service recovery /system/bin/recovery
    override
    socket recovery stream 422 system system
    seclabel u:r:recovery:s0
    setenv LD_PRELOAD /system/lib64/liba9_recovery_crypto_wait.so

# TWRP's ueventd never reads /vendor/ueventd.rc, so the TZ device nodes keep
# their default 0600 root:root instead of stock's:
#   /dev/ion 0664 system system ; /dev/qseecom 0660 system drmrpc ;
#   /dev/smcinvoke 0660 system drmrpc
# The QTI keymaster HAL SIGABRTs when it cannot open them.
on init
    chown system system /dev/ion
    chmod 0666 /dev/ion
    chown system drmrpc /dev/qseecom
    chmod 0666 /dev/qseecom
    chown system drmrpc /dev/smcinvoke
    chmod 0666 /dev/smcinvoke

# Minimal logd replacement: binds /dev/socket/logdw and dumps every liblog
# record to /tmp/logdw.txt. Recovery has no logd, so Rust panics in keystore2
# and every libbase LOG(FATAL) are otherwise invisible.
service logdstub /system/bin/logdstub
    class core
    user root
    group root
    seclabel u:r:recovery:s0

on early-init
    start logdstub

# FBE per-file keys: vold's installProvisioningKey() does
#   keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0)
# and bails with "Unable to find device keyring: Required key not available"
# if that named keyring does not exist. On a normal boot AOSP init creates it
# via libfscrypt's fscrypt_install_keyring(); TWRP's init never does. The
# FS_IOC_ADD_ENCRYPTION_KEY ioctl itself SUCCEEDS -- installKey() then fails on
# the provisioning-key step, and TWRP's retry hack flips use_hw_wrapped_key,
# so the retry legitimately fails with EINVAL. This creates the keyring in
# init's session keyring, which every init child (including recovery) shares.
service fscryptring /system/bin/fscryptring quiet
    class core
    user root
    group root
    oneshot
    seclabel u:r:recovery:s0

on early-init
    start fscryptring


# Boot control HAL, needed by fastbootd for slot-count / current-slot.
#
# fastbootd caches the HAL at construction (FastbootDevice's boot_control_hal_),
# so hwservicemanager's lazy-start always loses the race: fastbootd reports
# slot-count 0 and current-slot "", the host never appends _a, and
# `fastboot flash system <gsi>` cannot resolve the partition.
#
# Start it at post-fs instead -- after `on fs` creates the
# /dev/block/bootdevice symlink, and long before anything touches fastboot.
# The impl (/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.1-qti.so plus
# libboot_control_qti.so and librecovery_updater.so) is shipped in the RAMDISK
# /vendor, because process_fastbootd_mode() calls Unmap_Super_Devices() and the
# real /vendor is gone by the time fastbootd runs.
on post-fs
    start boot-hal-1-1
